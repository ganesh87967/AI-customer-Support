{
  "info": {
    "name": "SmartSupport AI - VCube Hack Quest",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Register User",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/register",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"CUSTOMER\"\n}"
        }
      }
    },
    {
      "name": "Login (Demo Customer)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"customer@demo.com\",\n  \"password\": \"password123\"\n}"
        }
      }
    },
    {
      "name": "Create Ticket (Triggers Spring AI)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/tickets",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Double charged on credit card\",\n  \"description\": \"I was charged twice for order #4921 and nobody is responding. This is urgent!\"\n}"
        }
      }
    },
    {
      "name": "List Tickets",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/tickets",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
      }
    },
    {
      "name": "Update Ticket Status",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/tickets/1/status",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"status\": \"RESOLVED\"\n}" }
      }
    },
    {
      "name": "Add Comment",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/tickets/1/comments",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"message\": \"Refund has been initiated.\",\n  \"isInternal\": false\n}" }
      }
    },
    {
      "name": "Submit Customer Feedback",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/tickets/1/feedback",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Fast and helpful resolution!\"\n}" }
      }
    },
    {
      "name": "Support Analytics",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/analytics",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
      }
    }
  ]
}
